{
  "name": "rehype-wayback",
  "version": "0.1.0",
  "description": "rehype plugin adding [archive] links to Wayback Machine snapshots, plus a Node API to find or create them",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./sync": "./sync.js"
  },
  "files": [
    "index.js",
    "sync.js",
    "lib/"
  ],
  "keywords": [
    "rehype",
    "rehype-plugin",
    "unified",
    "wayback-machine",
    "internet-archive",
    "link-rot"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
