---
import { render } from "astro:content";
import NotesLayout from "../layouts/NotesLayout.astro";
import Note from "../components/Note.astro";
import { getSluggedNotes } from "../utils/notes";
import { formatNoteTimestamp } from "../utils/date-helpers";

// Notes live at the site root (/2026oct05-02) alongside markdown pages, which
// [...slug].astro serves. Astro prefers this single-segment route over the
// rest route, so a page must never be named like a note slug.
export async function getStaticPaths() {
  const slugged = await getSluggedNotes();
  return slugged.map(({ note, slug }) => ({
    params: { note: slug },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<NotesLayout title={`${formatNoteTimestamp(note.data.publishedOn)} | Notes`}>
  <Note publishedOn={note.data.publishedOn} tags={note.data.tags}>
    <Content />
  </Note>
</NotesLayout>
