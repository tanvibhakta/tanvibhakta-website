---
import { render } from "astro:content";
import NotesLayout from "../../layouts/NotesLayout.astro";
import Note from "../../components/Note.astro";
import NoteSpine from "../../components/NoteSpine.astro";
import { getThreadedNotes } from "../../utils/notes";
import { feedLinks } from "../../utils/note-threads";

// Sorted oldest-first, displayed newest-first. Threads never reorder the
// feed: a thread note sits at its own date, and a margin line plus "N of M"
// say it belongs to a thread. Clicking a note opens its own page, which
// shows its conversation. Design:
// docs/plans/2026-10-05-notes-threading-design.md.
const threaded = await getThreadedNotes();
const rendered = await Promise.all(
  threaded.map(async (entry) => ({
    ...entry,
    Content: (await render(entry.note)).Content,
  })),
);
const feed = [...rendered].reverse();
const links = feedLinks(
  feed.map(({ note }) => note.id),
  new Map(
    threaded.flatMap(({ note, position }) =>
      position ? [[note.id, position] as const] : [],
    ),
  ),
);

const label = (index: number, size: number) => `${index + 1} of ${size}`;
---

<NotesLayout title="Notes">
  {feed.length === 0 && <p>No notes yet.</p>}
  {
    feed.map(({ note, slug, position, Content }) => (
      <div
        data-href={`/${slug}`}
        class="relative flow-root cursor-pointer py-4 first:pt-0 [&>article]:my-0 [&>article>:first-child]:mt-0"
      >
        {position && <NoteSpine {...links.get(note.id)!} />}
        <Note
          publishedOn={note.data.publishedOn}
          href={`/${slug}`}
          tags={note.data.tags}
        >
          <Content />
          {position && (
            <span slot="meta">{label(position.index, position.size)}</span>
          )}
        </Note>
      </div>
    ))
  }
</NotesLayout>

<script>
  import "../../scripts/open-note-on-click";
</script>
