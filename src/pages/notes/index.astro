---
import { render } from "astro:content";
import NotesLayout from "../../layouts/NotesLayout.astro";
import Note from "../../components/Note.astro";
import { getSluggedNotes } from "../../utils/notes";

// Sorted oldest-first, displayed newest-first.
const slugged = await getSluggedNotes();
const rendered = await Promise.all(
  [...slugged].reverse().map(async ({ note, slug }) => ({
    note,
    slug,
    Content: (await render(note)).Content,
  })),
);
---

<NotesLayout title="Notes">
  {rendered.length === 0 && <p>No notes yet.</p>}
  {
    rendered.map(({ note, slug, Content }) => (
      <Note
        publishedOn={note.data.publishedOn}
        href={`/${slug}`}
        tags={note.data.tags}
      >
        <Content />
      </Note>
    ))
  }
</NotesLayout>
