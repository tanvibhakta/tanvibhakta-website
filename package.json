    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "astro-icon": "^1.2.0",
    "markdown-it": "^14.3.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "sanitize-html": "^2.17.7",
